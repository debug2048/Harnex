# Harnex — optional deployment settings.
# Quick start: docker compose up -d --build (no .env or API key required).
# Open the Web UI and configure a model service in Settings before sending tasks.
# Copy this file to `.env` only to override ports, use a host project, or supply
# model credentials through environment variables instead of the Web UI.

# ---------- Optional host project ----------
# The default /workspace uses a persistent Docker-managed volume.
# To edit an existing host project, set an absolute directory and also load
# docker-compose.workspace.yml; see docs/04_部署方案.md, Docker Compose deployment.
# HARNEX_WORKSPACE_HOST=/srv/my-project

# ---------- LLM providers ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Optional native OpenAI Responses provider. It reuses OPENAI_API_KEY.
OPENAI_RESPONSES_BASE_URL=https://api.openai.com/v1
OPENAI_RESPONSES_DEFAULT_MODEL=gpt-5.1

FALLBACK_API_KEY=
FALLBACK_BASE_URL=https://api.deepseek.com/v1
FALLBACK_DEFAULT_MODEL=deepseek-v4-flash

# Optional native Anthropic provider (Messages API). Leave empty to disable.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_DEFAULT_MODEL=claude-opus-4-8

# Keys for optional user-defined providers using the built-in Kimi/Grok/Gemini profiles.
# Add the corresponding provider entry to external agent-config.yml; set router.default-provider if it should be the default.
MOONSHOT_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=

# ---------- Access boundary ----------
# The GUI is accountless and the Compose ports bind to loopback by default. For remote
# access, put an authenticated HTTPS reverse proxy / SSO gateway in front instead of
# exposing these ports directly. For domain access, set the exact browser origin.
# HARNEX_WEB_ORIGIN=https://harnex.example.com

# Each view starts its own JVM on first use; both may stay running after a view switch.
HARNEX_SUPERVISOR_JAVA_XMS=64m
HARNEX_SUPERVISOR_JAVA_XMX=512m

# ---------- Command execution (on the Runtime host) ----------
# Normal development uses the existing host toolchain. SSH connects a complete Runtime.
HARNEX_EXECUTION_ENVIRONMENT=host
HARNEX_EXECUTION_SANDBOX_MODE=none
HARNEX_EXECUTION_SANDBOX_NETWORK=deny
HARNEX_EXECUTION_IMAGE=debian:stable-slim
HARNEX_EXECUTION_MEMORY=512m
HARNEX_EXECUTION_CPUS=1
HARNEX_EXECUTION_PIDS=256
# Isolation is optional. sandbox-network applies only to an explicitly sandboxed command or Docker.

# ---------- IM gateway ----------
# Generic /api/gateway/inbound — HMAC-SHA256 hex secret on X-HARNEX-Signature header.
HARNEX_GATEWAY_SECRET=
# Per-platform secrets — leave blank to disable that channel.
HARNEX_DINGTALK_SECRET=
HARNEX_WECOM_TOKEN=
HARNEX_FEISHU_SECRET=
HARNEX_FEISHU_VTOKEN=
# Alertmanager (B3) — Prometheus inbound webhook
HARNEX_ALERTMANAGER_SECRET=

# ---------- MCP integrations (B2 first-class samples) ----------
# Uncomment + set the corresponding entry in agent-config.yml under `harnex.mcp.servers`
# to expose Prometheus / GitHub tools to the agent. Both are READ-ONLY by default.
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_BEARER_TOKEN=
GITHUB_TOKEN=

# ---------- History summariser ----------
# Cheap side-channel model for compressing long histories.
HARNEX_SUMMARIZER_ENABLED=true
HARNEX_SUMMARIZER_PROVIDER=fallback
HARNEX_SUMMARIZER_MODEL=
HARNEX_SUMMARIZER_MAX_OUTPUT_TOKENS=4096
HARNEX_SUMMARIZER_MAX_CONCURRENT=2
HARNEX_SUMMARIZER_TIMEOUT_MS=90000

# ---------- Vision / OCR ----------
HARNEX_VISION_ENABLED=true
HARNEX_OCR_FALLBACK=true
HARNEX_OCR_LANG=eng+chi_sim

# ---------- Web search (web_search tool) ----------
# Pluggable web search; v1 backend is Tavily (https://tavily.com — free tier available).
# Leave HARNEX_WEBSEARCH_KEY blank to keep the tool hidden from the model entirely.
HARNEX_WEBSEARCH_ENABLED=true
HARNEX_WEBSEARCH_PROVIDER=tavily
HARNEX_WEBSEARCH_KEY=
HARNEX_WEBSEARCH_ENDPOINT=

# ---------- Autonomous goal (/goal) + plan (/plan) guard rails ----------
HARNEX_GOAL_MAX_TURNS=25
HARNEX_GOAL_TOKEN_BUDGET=0          # 0 = unlimited unless "/goal … +budget" is given
HARNEX_GOAL_WALLCLOCK_MS=0          # 0 = unlimited
HARNEX_PLAN_REVIEW_TIMEOUT_MS=1800000

# ---------- Logging (A5) ----------
# Log files roll daily and are capped per-file + total. Defaults are tuned for a
# single-team appliance — raise HARNEX_LOG_RETENTION_DAYS / HARNEX_LOG_TOTAL_SIZE_CAP
# for compliance use cases.
# Compose persists project files/data/Skills under /workspace and user configuration/personal data under /root/.harnex.
# Each Runtime writes logs in its own data directory; Supervisor logs are under /root/.harnex/runtime-domains.
HARNEX_LOG_LEVEL_ROOT=INFO
HARNEX_LOG_LEVEL_APP=INFO
HARNEX_LOG_RETENTION_DAYS=14
HARNEX_LOG_TOTAL_SIZE_CAP=1GB

# ---------- Port mapping ----------
# Override only if 8088 / 18081 are already taken on the host.
HARNEX_BIND_ADDRESS=127.0.0.1
HARNEX_BACKEND_PORT=8088
HARNEX_FRONTEND_PORT=18081

# ---------- Reverse-proxy headers ----------
# Set to `none` if you DON'T have a trusted proxy in front (avoids forwarded-header spoofing).
HARNEX_FORWARD_HEADERS_STRATEGY=framework
